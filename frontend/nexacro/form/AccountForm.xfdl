<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="AccountForm" width="1100" height="740" titletext="계좌 조회 / 이체" onload="AccountForm_onload">
    <Layouts>
      <Layout width="1100" height="740">
        <Static id="staTitle" left="10" top="10" width="300" height="24" text="계좌 목록"/>
        <Button id="btnSearch" left="990" top="8" width="90" height="26" text="조회" onclick="btnSearch_onclick"/>
        <Grid id="grdAccount" left="10" top="40" width="1070" height="200" binddataset="dsAccount" oncellclick="grdAccount_oncellclick">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="180"/><Column size="200"/><Column size="180"/><Column size="100"/><Column size="180"/>
              </Columns>
              <Rows><Row size="26" band="head"/><Row size="26"/></Rows>
              <Band id="head">
                <Cell text="계좌번호"/><Cell col="1" text="고객명"/><Cell col="2" text="잔액"/><Cell col="3" text="상태"/><Cell col="4" text="등록일"/>
              </Band>
              <Band id="body">
                <Cell text="bind:acctNo"/><Cell col="1" text="bind:custNm"/><Cell col="2" text="bind:balance" displaytype="number" textAlign="right"/><Cell col="3" text="bind:statusCd"/><Cell col="4" text="bind:regDt"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <Static id="staHist" left="10" top="250" width="300" height="24" text="거래내역 (선택 계좌)"/>
        <Grid id="grdHist" left="10" top="278" width="1070" height="200" binddataset="dsHist">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/><Column size="80"/><Column size="150"/><Column size="150"/><Column size="180"/><Column size="200"/><Column size="180"/>
              </Columns>
              <Rows><Row size="26" band="head"/><Row size="26"/></Rows>
              <Band id="head">
                <Cell text="순번"/><Cell col="1" text="구분"/><Cell col="2" text="금액"/><Cell col="3" text="거래후잔액"/><Cell col="4" text="상대계좌"/><Cell col="5" text="메모"/><Cell col="6" text="거래일시"/>
              </Band>
              <Band id="body">
                <Cell text="bind:transSeq"/><Cell col="1" text="bind:transTp"/><Cell col="2" text="bind:amount" displaytype="number" textAlign="right"/><Cell col="3" text="bind:balanceAfter" displaytype="number" textAlign="right"/><Cell col="4" text="bind:counterAcctNo"/><Cell col="5" text="bind:memo"/><Cell col="6" text="bind:transDt"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <Static id="staTransfer" left="10" top="500" width="300" height="24" text="계좌 이체"/>
        <Static id="staFrom" left="10" top="532" width="90" height="26" text="출금계좌"/>
        <Edit id="edtFrom" left="100" top="532" width="180" height="26"/>
        <Static id="staTo" left="300" top="532" width="90" height="26" text="입금계좌"/>
        <Edit id="edtTo" left="390" top="532" width="180" height="26"/>
        <Static id="staAmt" left="590" top="532" width="60" height="26" text="금액"/>
        <Edit id="edtAmount" left="650" top="532" width="140" height="26"/>
        <Static id="staMemo" left="810" top="532" width="50" height="26" text="메모"/>
        <Edit id="edtMemo" left="860" top="532" width="220" height="26"/>
        <Button id="btnTransfer" left="990" top="570" width="90" height="28" text="이체" onclick="btnTransfer_onclick"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="dsAccount">
        <ColumnInfo>
          <Column id="acctNo" type="STRING" size="32"/>
          <Column id="custNm" type="STRING" size="100"/>
          <Column id="balance" type="BIGDECIMAL" size="20"/>
          <Column id="statusCd" type="STRING" size="1"/>
          <Column id="regDt" type="STRING" size="14"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsHist">
        <ColumnInfo>
          <Column id="transSeq" type="BIGDECIMAL" size="20"/>
          <Column id="acctNo" type="STRING" size="32"/>
          <Column id="transTp" type="STRING" size="1"/>
          <Column id="amount" type="BIGDECIMAL" size="20"/>
          <Column id="balanceAfter" type="BIGDECIMAL" size="20"/>
          <Column id="counterAcctNo" type="STRING" size="32"/>
          <Column id="memo" type="STRING" size="200"/>
          <Column id="transDt" type="STRING" size="14"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsAccountDetail">
        <ColumnInfo>
          <Column id="acctNo" type="STRING" size="32"/>
          <Column id="custNm" type="STRING" size="100"/>
          <Column id="balance" type="BIGDECIMAL" size="20"/>
          <Column id="statusCd" type="STRING" size="1"/>
          <Column id="regDt" type="STRING" size="14"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsCond">
        <ColumnInfo><Column id="acctNo" type="STRING" size="32"/></ColumnInfo>
      </Dataset>
      <Dataset id="dsTransfer">
        <ColumnInfo>
          <Column id="fromAcctNo" type="STRING" size="32"/>
          <Column id="toAcctNo" type="STRING" size="32"/>
          <Column id="amount" type="BIGDECIMAL" size="20"/>
          <Column id="memo" type="STRING" size="200"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="bindFrom" compid="edtFrom" propid="value" datasetid="dsTransfer" columnid="fromAcctNo"/>
      <BindItem id="bindTo" compid="edtTo" propid="value" datasetid="dsTransfer" columnid="toAcctNo"/>
      <BindItem id="bindAmount" compid="edtAmount" propid="value" datasetid="dsTransfer" columnid="amount"/>
      <BindItem id="bindMemo" compid="edtMemo" propid="value" datasetid="dsTransfer" columnid="memo"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[
include "lib::Common.xjs";

this.AccountForm_onload = function(obj, e)
{
    this.dsTransfer.clearData();
    this.dsTransfer.addRow();
    this.fn_search();
};

this.btnSearch_onclick = function(obj, e)
{
    this.fn_search();
};

// [direct] 계좌 목록 조회 : this.transaction 직접 호출
this.fn_search = function()
{
    this.transaction(
        "selectAccountList",
        "svc::nexacro/account/selectAccountList.do",
        "",
        "dsAccount=dsAccount",
        "",
        "fn_callback"
    );
};

// [wrapper] 선택 계좌 상세 + 거래내역 : 공통 함수 gfnTransaction 경유
this.grdAccount_oncellclick = function(obj, e)
{
    var sAcctNo = this.dsAccount.getColumn(e.row, "acctNo");
    this.dsCond.clearData();
    this.dsCond.addRow();
    this.dsCond.setColumn(0, "acctNo", sAcctNo);

    this.gfnTransaction(
        "selectAccount",
        "svc::nexacro/account/selectAccount.do",
        "dsCond=dsCond",
        "dsAccountDetail=dsAccount dsHist=dsHist",
        "",
        "fn_callback"
    );
    this.dsTransfer.setColumn(0, "fromAcctNo", sAcctNo);
};

// [wrapper] 계좌 이체
this.btnTransfer_onclick = function(obj, e)
{
    if (this.gfnIsNull(this.dsTransfer.getColumn(0, "fromAcctNo")) ||
        this.gfnIsNull(this.dsTransfer.getColumn(0, "toAcctNo"))) {
        this.alert("출금/입금 계좌번호를 입력하세요.");
        return;
    }
    this.gfnTransaction(
        "transfer",
        "svc::nexacro/account/transfer.do",
        "dsTransfer=dsTransfer",
        "",
        "",
        "fn_callback"
    );
};

this.fn_callback = function(sSvcId, nErrorCode, sErrorMsg)
{
    if (nErrorCode < 0) {
        this.alert("[" + nErrorCode + "] " + sErrorMsg);
        return;
    }
    if (sSvcId == "transfer") {
        this.alert("이체가 완료되었습니다.");
        this.fn_search();
    }
};
]]></Script>
  </Form>
</FDL>
