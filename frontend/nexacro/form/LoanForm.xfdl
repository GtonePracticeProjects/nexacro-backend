<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="LoanForm" width="1100" height="740" titletext="대출 조회 / 신청 / 심사" onload="LoanForm_onload">
    <Layouts>
      <Layout width="1100" height="740">
        <Static id="staStatus" left="10" top="10" width="80" height="26" text="상태(R/A/X)"/>
        <Edit id="edtStatus" left="90" top="10" width="100" height="26"/>
        <Button id="btnSearch" left="200" top="10" width="90" height="26" text="조회" onclick="btnSearch_onclick"/>
        <Button id="btnApprove" left="880" top="10" width="90" height="26" text="승인" onclick="btnDecide_onclick"/>
        <Button id="btnReject" left="980" top="10" width="90" height="26" text="거절" onclick="btnDecide_onclick"/>
        <Grid id="grdLoan" left="10" top="46" width="1070" height="300" binddataset="dsLoan">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="100"/><Column size="180"/><Column size="150"/><Column size="80"/><Column size="80"/><Column size="150"/><Column size="80"/><Column size="180"/>
              </Columns>
              <Rows><Row size="26" band="head"/><Row size="26"/></Rows>
              <Band id="head">
                <Cell text="대출번호"/><Cell col="1" text="계좌번호"/><Cell col="2" text="원금"/><Cell col="3" text="금리"/><Cell col="4" text="기간(월)"/><Cell col="5" text="월납입액"/><Cell col="6" text="상태"/><Cell col="7" text="신청일"/>
              </Band>
              <Band id="body">
                <Cell text="bind:loanNo"/><Cell col="1" text="bind:acctNo"/><Cell col="2" text="bind:principal" displaytype="number" textAlign="right"/><Cell col="3" text="bind:rate"/><Cell col="4" text="bind:termMonths"/><Cell col="5" text="bind:monthlyPay" displaytype="number" textAlign="right"/><Cell col="6" text="bind:statusCd"/><Cell col="7" text="bind:reqDt"/>
              </Band>
            </Format>
          </Formats>
        </Grid>

        <Static id="staApply" left="10" top="370" width="300" height="24" text="대출 신청"/>
        <Static id="staAcct" left="10" top="402" width="70" height="26" text="계좌번호"/>
        <Edit id="edtAcct" left="80" top="402" width="180" height="26"/>
        <Static id="staPrincipal" left="280" top="402" width="50" height="26" text="원금"/>
        <Edit id="edtPrincipal" left="330" top="402" width="160" height="26"/>
        <Static id="staTerm" left="510" top="402" width="80" height="26" text="기간(월)"/>
        <Edit id="edtTerm" left="590" top="402" width="80" height="26"/>
        <Button id="btnApply" left="990" top="402" width="90" height="26" text="신청" onclick="btnApply_onclick"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="dsLoan">
        <ColumnInfo>
          <Column id="loanNo" type="BIGDECIMAL" size="20"/>
          <Column id="acctNo" type="STRING" size="32"/>
          <Column id="principal" type="BIGDECIMAL" size="20"/>
          <Column id="rate" type="BIGDECIMAL" size="10"/>
          <Column id="termMonths" type="INT" size="5"/>
          <Column id="monthlyPay" type="BIGDECIMAL" size="20"/>
          <Column id="statusCd" type="STRING" size="1"/>
          <Column id="reqDt" type="STRING" size="14"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsCond">
        <ColumnInfo><Column id="statusCd" type="STRING" size="1"/></ColumnInfo>
      </Dataset>
      <Dataset id="dsApply">
        <ColumnInfo>
          <Column id="acctNo" type="STRING" size="32"/>
          <Column id="principal" type="BIGDECIMAL" size="20"/>
          <Column id="termMonths" type="INT" size="5"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsDecide">
        <ColumnInfo><Column id="loanNo" type="BIGDECIMAL" size="20"/></ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="bindStatus" compid="edtStatus" propid="value" datasetid="dsCond" columnid="statusCd"/>
      <BindItem id="bindAcct" compid="edtAcct" propid="value" datasetid="dsApply" columnid="acctNo"/>
      <BindItem id="bindPrincipal" compid="edtPrincipal" propid="value" datasetid="dsApply" columnid="principal"/>
      <BindItem id="bindTerm" compid="edtTerm" propid="value" datasetid="dsApply" columnid="termMonths"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[
include "lib::Common.xjs";

this.LoanForm_onload = function(obj, e)
{
    this.dsCond.addRow();
    this.dsApply.addRow();
    this.dsDecide.addRow();
    this.fn_search();
};

this.btnSearch_onclick = function(obj, e)
{
    this.fn_search();
};

// [wrapper] 대출 목록 조회
this.fn_search = function()
{
    this.gfnTransaction(
        "selectLoanList",
        "svc::nexacro/loan/selectLoanList.do",
        "dsCond=dsCond",
        "dsLoan=dsLoan",
        "",
        "fn_callback"
    );
};

// [direct] 대출 신청 : this.transaction 직접 호출
this.btnApply_onclick = function(obj, e)
{
    this.transaction(
        "applyLoan",
        "svc::nexacro/loan/applyLoan.do",
        "dsApply=dsApply",
        "",
        "",
        "fn_callback"
    );
};

// [concatenated] 승인/거절 : URL 을 문자열 연결로 조립 (approveLoan.do / rejectLoan.do)
this.btnDecide_onclick = function(obj, e)
{
    var nRow = this.dsLoan.rowposition;
    if (nRow < 0) {
        this.alert("대출 건을 선택하세요.");
        return;
    }
    this.dsDecide.setColumn(0, "loanNo", this.dsLoan.getColumn(nRow, "loanNo"));

    var sAct = (obj.id == "btnApprove") ? "approve" : "reject";
    this.transaction(
        "decideLoan",
        "svc::nexacro/loan/" + sAct + "Loan.do",
        "dsDecide=dsDecide",
        "",
        "",
        "fn_callback"
    );
};

this.fn_callback = function(sSvcId, nErrorCode, sErrorMsg)
{
    if (nErrorCode < 0) {
        this.alert("[" + nErrorCode + "] " + sErrorMsg);
        return;
    }
    if (sSvcId == "applyLoan" || sSvcId == "decideLoan") {
        this.fn_search();
    }
};
]]></Script>
  </Form>
</FDL>
